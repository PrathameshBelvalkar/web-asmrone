<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup and no device transfer. The asmr.one token is encrypted with an
     Android Keystore key that never leaves the device, so a restored copy could not be read anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
